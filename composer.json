{
  "name": "elavora/api-storage-local",
  "description": "Armazenamento local opcional para o framework Elavora",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "elavora/api-framework": "^0.3.1"
  },
  "autoload": {
    "psr-4": {
      "Elavora\\Api\\Extension\\StorageLocal\\": "src/"
    }
  },
  "require-dev": {
    "elavora/code-standards": "^1.1",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "scripts": {
    "lint": "elavora-standards lint",
    "test": "phpunit -c phpunit.xml",
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "check": [
      "@lint",
      "@test",
      "@analyse"
    ],
    "post-install-cmd": ["Elavora\\CodeStandards\\Composer::sync"],
    "post-update-cmd": ["Elavora\\CodeStandards\\Composer::sync"]
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1-dev"
    }
  }
}
